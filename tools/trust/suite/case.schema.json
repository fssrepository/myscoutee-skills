{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myscoutee.local/tools/trust/suite/case.schema.json",
  "title": "MyScoutee trust regression case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "title",
    "tags",
    "prompt",
    "assertions",
    "reviewQuestions"
  ],
  "properties": {
    "$schema": {
      "const": "../case.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^T[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "prompt": {
      "type": "string",
      "minLength": 20
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "reviewQuestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "patterns"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "kind": {
          "enum": ["required", "required_question", "forbidden"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
